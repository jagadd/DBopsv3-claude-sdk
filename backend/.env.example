ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
PORT=3001

# Option A: your HTTPS-enabled dbatools MCP fork
DBATOOLS_MCP_URL=https://your-mcp-host:8443/mcp
DBATOOLS_MCP_TOKEN=

# Option B: local stdio server (used only when DBATOOLS_MCP_URL is empty)
# DBATOOLS_MCP_COMMAND=npx
# DBATOOLS_MCP_ARGS=-y dbatools-mcp-server@latest
# DBATOOLS_SAFE_MODE=true
