# --- Claude via Microsoft Foundry ---
CLAUDE_CODE_USE_FOUNDRY=1
# Azure resource name, i.e. https://<resource>.services.ai.azure.com
ANTHROPIC_FOUNDRY_RESOURCE=
# Alternative to ANTHROPIC_FOUNDRY_RESOURCE: full base URL
# ANTHROPIC_FOUNDRY_BASE_URL=
ANTHROPIC_FOUNDRY_API_KEY=
# Foundry deployment name of Claude Sonnet 5.5 (coordinator and all subagents)
CLAUDE_MODEL=claude-sonnet-5-5

# --- dbatools MCP server ---
# Option A: HTTPS endpoint
DBATOOLS_MCP_URL=https://your-mcp-host:8443/mcp
DBATOOLS_MCP_TOKEN=
# CA certificate for a self-signed MCP server certificate
# NODE_EXTRA_CA_CERTS=/home/you/mcp-certs/server-cert.pem
# Option B: local stdio server (used only when DBATOOLS_MCP_URL is empty)
# DBATOOLS_MCP_COMMAND=npx
# DBATOOLS_MCP_ARGS=-y dbatools-mcp-server@latest

# --- Managed SQL Server instances ---
# Configuration item -> how dbatools connects. Tickets for anything not listed are escalated untouched.
# computer_name: host for Windows-level commands (no port). credential_refs: dbatools credential parameter ->
# credential profile alias saved on the MCP host (save-credential.ps1); passed as credentialRefs.
DBAOPS_INSTANCES={"10.10.0.5": {"sql_instance": "localhost"}, "10.70.1.5": {"sql_instance": "10.70.1.5,1433", "computer_name": "10.70.1.5", "credential_refs": {"SqlCredential": "windowstest-reader", "Credential": "windowstest-admin"}}}

# --- This API (pipeline intake, trace, approvals) ---
# Bearer token for every /api endpoint (also used in Swagger UI "Authorize")
DBAOPS_API_TOKEN=
# SQLite file for runs, per-incident trace and approvals
DBAOPS_DB_PATH=dbaops.db

# --- ITSM-mimic frontend (work notes / state go here) ---
ITSM_BASE_URL=http://localhost:8080
ITSM_TOKEN=

# --- Agent limits ---
DBAOPS_MAX_TURNS=40
DBAOPS_SUBAGENT_MAX_TURNS=25
# Agent working time per run; paused while waiting for human approval
DBAOPS_RUN_TIMEOUT_SECONDS=900
# How long a change waits for a human decision before it is treated as denied
DBAOPS_APPROVAL_TIMEOUT_SECONDS=3600
